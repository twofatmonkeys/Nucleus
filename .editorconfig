root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
# for_non_interface_members, not always: interface members are implicitly public and writing it
# out is noise that IDE0040 would otherwise demand.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

[*.{json,yml,yaml,slnx,csproj,props,targets,config}]
indent_size = 2

[*.{js,css,html,cshtml,razor}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
