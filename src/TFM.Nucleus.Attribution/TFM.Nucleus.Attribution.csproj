<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything shared lives in ..\Directory.Build.props and ..\..\Directory.Build.props. A package
    csproj should only carry what is genuinely specific to this package: its identity, its
    description, its tags and its dependencies.
  -->

  <PropertyGroup>
    <PackageId>TFM.Nucleus.Attribution</PackageId>
    <Title>TFM.Nucleus.Attribution</Title>
    <RootNamespace>TFM.Nucleus.Attribution</RootNamespace>
    <Description>Keeps TFM.Attribution's touches and frozen sales in Nucleus tables: NucleusAttributionStore implements IAttributionStore over three CoreObject entities, with touch writes that are safe to retry and sale replacement on one transaction, provider neutral, so a site on the Nucleus ORM registers AddAttribution&lt;NucleusAttributionStore&gt; and its schema is created and migrated on startup like every other entity.</Description>
    <PackageTags>tfm;nucleus;orm;attribution;marketing;utm;store;adapter</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- TFM.Attribution multi-targets the same two frameworks from one version, so the two lines
         name the same version on purpose: pinned per target framework like every other reference
         in the repo. Bump both together; the store follows the library's store contract and its
         touch columns. -->
    <PackageReference Include="TFM.Attribution" Version="1.26.277.3" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="TFM.Attribution" Version="1.26.277.3" Condition="'$(TargetFramework)' == 'net10.0'" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provider neutral on purpose: never TFM.Nucleus.Data.SQL. The host registers the provider. -->
    <ProjectReference Include="..\TFM.Nucleus.Abstractions\TFM.Nucleus.Abstractions.csproj" />
    <ProjectReference Include="..\TFM.Nucleus\TFM.Nucleus.csproj" />
    <ProjectReference Include="..\TFM.Nucleus.Data\TFM.Nucleus.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the list to real test projects: every entry here is a hole in the assembly boundary. -->
    <InternalsVisibleTo Include="TFM.Nucleus.IntegrationTests" />
  </ItemGroup>

</Project>
