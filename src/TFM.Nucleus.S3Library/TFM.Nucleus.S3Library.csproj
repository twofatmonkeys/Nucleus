<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything shared lives in ..\Directory.Build.props and ..\..\Directory.Build.props. A package
    csproj should only carry what is genuinely specific to this package: its identity, its
    description, its tags and its dependencies.
  -->

  <PropertyGroup>
    <PackageId>TFM.Nucleus.S3Library</PackageId>
    <Title>TFM.Nucleus.S3Library</Title>
    <RootNamespace>TFM.Nucleus.S3Library</RootNamespace>
    <Description>Keeps TFM.S3Library's asset metadata in Nucleus tables: NucleusS3AssetStore implements IS3AssetStore over three CoreObject entities, with the version check and the live-path uniqueness rule enforced by unique indexes, provider neutral, so a site on the Nucleus ORM registers AddS3Library&lt;NucleusS3AssetStore&gt; and its schema is created and migrated on startup like every other entity.</Description>
    <PackageTags>tfm;nucleus;orm;s3;assets;media;store;adapter</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- TFM.S3Library.Abstractions multi-targets the same two frameworks from one version, so the
         two lines name the same version on purpose: pinned per target framework like every other
         reference in the repo. Bump both together; the store follows the library's store contract. -->
    <PackageReference Include="TFM.S3Library.Abstractions" Version="1.26.250.3" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="TFM.S3Library.Abstractions" Version="1.26.250.3" Condition="'$(TargetFramework)' == 'net10.0'" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provider neutral on purpose: never TFM.Nucleus.Data.SQL. The host registers the provider. -->
    <ProjectReference Include="..\TFM.Nucleus.Abstractions\TFM.Nucleus.Abstractions.csproj" />
    <ProjectReference Include="..\TFM.Nucleus\TFM.Nucleus.csproj" />
    <ProjectReference Include="..\TFM.Nucleus.Data\TFM.Nucleus.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the list to real test projects: every entry here is a hole in the assembly boundary. -->
    <InternalsVisibleTo Include="TFM.Nucleus.IntegrationTests" />
  </ItemGroup>

</Project>
