<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything shared lives in ..\Directory.Build.props and ..\..\Directory.Build.props. A package
    csproj should only carry what is genuinely specific to this package: its identity, its
    description, its tags and its dependencies.
  -->

  <PropertyGroup>
    <PackageId>TFM.Nucleus.Testing</PackageId>
    <Title>TFM.Nucleus.Testing</Title>
    <RootNamespace>TFM.Nucleus.Testing</RootNamespace>
    <Description>Live-database test support for code built on the Nucleus ORM, framework neutral: the SQL Server and PostgreSQL test database settings (user secrets or environment variables), a booted Nucleus stack per provider, cross-process locks so parallel target framework runs never reset each other's rows, and the raw statements a test needs to set up a table by hand. Each test framework turns "not configured" into its own skip.</Description>
    <PackageTags>tfm;nucleus;orm;testing;integration-tests</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package references are pinned per target framework so each consumer gets the assemblies
         built for their runtime rather than a lowest common denominator set. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />

    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TFM.Nucleus.Abstractions\TFM.Nucleus.Abstractions.csproj" />
    <ProjectReference Include="..\TFM.Nucleus\TFM.Nucleus.csproj" />
    <ProjectReference Include="..\TFM.Nucleus.Data\TFM.Nucleus.Data.csproj" />
    <ProjectReference Include="..\TFM.Nucleus.Data.SQL\TFM.Nucleus.Data.SQL.csproj" />
    <ProjectReference Include="..\TFM.Nucleus.Data.PostgreSQL\TFM.Nucleus.Data.PostgreSQL.csproj" />
  </ItemGroup>

</Project>
