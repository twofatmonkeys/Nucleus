<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test harness packages and the IsPackable/IsTestProject settings come from
       ..\Directory.Build.props, so this project needs nothing but its ProjectReferences. -->

  <ItemGroup>
    <!-- Needed by the registration tests, which build a container to prove AddNucleus and
         AddNucleusLogging are idempotent. Pinned per target framework like the shipping projects. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TFM.Nucleus.Abstractions\TFM.Nucleus.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\TFM.Nucleus\TFM.Nucleus.csproj" />
    <ProjectReference Include="..\..\src\TFM.Nucleus.Data\TFM.Nucleus.Data.csproj" />
    <ProjectReference Include="..\..\src\TFM.Nucleus.Data.SQL\TFM.Nucleus.Data.SQL.csproj" />
    <ProjectReference Include="..\..\src\TFM.Nucleus.Data.PostgreSQL\TFM.Nucleus.Data.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\TFM.Nucleus.Data.SQLite\TFM.Nucleus.Data.SQLite.csproj" />
    <!-- The test support package, for its public surface snapshot. -->
    <ProjectReference Include="..\..\src\TFM.Nucleus.Testing\TFM.Nucleus.Testing.csproj" />
  </ItemGroup>

</Project>
