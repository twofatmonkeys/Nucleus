<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	  <Title>TFM.Nucleus</Title>
	  <Authors>Two Fat Monkeys</Authors>
	  <Company>Two Fat Monkeys</Company>
	  <RootNamespace>TFM.Nucleus</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <AssemblyName>TFM.Nucleus</AssemblyName>
	  <AssemblyVersion>1.26.194.0</AssemblyVersion>
	  <FileVersion>1.26.194.0</FileVersion>
	  <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	  <PackageIcon>icon.png</PackageIcon>
	  <PackageOutputPath>nuget\</PackageOutputPath>
	  <RepositoryUrl>https://github.com/twofatmonkeys/Nucleus</RepositoryUrl>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <GeneratePackageOnBuild Condition="Exists('$(USERPROFILE)\source\nuget\')">true</GeneratePackageOnBuild>
	  <PackageOutputPath Condition="Exists('$(USERPROFILE)\source\nuget\')">$(USERPROFILE)\source\nuget\</PackageOutputPath>
  </PropertyGroup>
	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
		<None Include="LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="9.0.2" />
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup Condition="!Exists('../Nucleus Abstractions/Nucleus Abstractions.csproj')">
		<PackageReference Include="TFM.Nucleus.Abstractions" Version="1.25.*" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Nucleus Abstractions\Nucleus Abstractions.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="TFM.Nucleus.Tests" />
	</ItemGroup>



</Project>
