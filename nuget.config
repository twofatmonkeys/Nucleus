<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- clear drops any machine level or user level sources, so a restore resolves the same way on a
       dev box as it does on a clean CI runner. -->
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/twofatmonkeys/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    GitHub Packages requires authentication even for reads. The credentials come from environment
    variables so nothing secret is committed:

      local  - set GITHUB_USER to your GitHub username and GITHUB_TOKEN to a classic PAT with the
               read:packages scope.
      CI     - the release workflow sets GITHUB_USER to the repository owner and GITHUB_TOKEN to
               the job's automatic secrets.GITHUB_TOKEN.

    Because this file supplies the credential, the workflow does not pass source-url to
    actions/setup-dotnet, which would otherwise overwrite this file on the runner.
  -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>

  <!--
    Source mapping closes the dependency confusion hole: TFM.* resolves from our own feed only, so
    somebody registering a TFM.Something on nuget.org cannot get their package into our builds.

    If a TFM package ever lives on nuget.org and not on GitHub Packages, add that one package as an
    explicit pattern under nuget.org (for example <package pattern="TFM.ApplePay" />). Do not
    weaken the TFM.* rule to a wildcard.
  -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="TFM.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
