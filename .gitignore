# Build output
[Bb]in/
[Oo]bj/

# Local pack output. The release workflow republishes from here on every run, so there is never a
# reason to commit a .nupkg.
artifacts/

# Test output
[Tt]est[Rr]esults/
*.trx
*.coverage
coverage*.json
coverage*.xml

# IDE
.vs/
.idea/
*.user
*.suo
*.userprefs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# OS
.DS_Store
Thumbs.db

# Credentials. Nothing here should ever exist in the repo, but the ignore is cheap insurance.
*.snk
*.pfx
appsettings.*.local.json
.env

# Private local work. Never committed.
/private/
